includes:
    - phpstan-baseline.neon
    # Generated XDR types are produced by tools/xdr-generator and validated by
    # the round-trip test suite. PHPStan cannot exclude by file content, so
    # generate.rb writes the list of their paths to this file; the hand-written
    # classes in Soneso/StellarSDK/Xdr are analysed.
    - tools/xdr-generator/phpstan-generated.neon

parameters:
    level: 6
    paths:
        - Soneso/StellarSDK
